{
  "name": "clima-el-polo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name clima-el-polo",
    "db:local": "wrangler d1 migrations apply clima-el-polo --local",
    "db:remote": "wrangler d1 migrations apply clima-el-polo --remote"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
