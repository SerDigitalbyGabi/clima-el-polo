{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clima-el-polo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // el Worker atiende todo para poder pedir sesión antes de servir el panel
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clima-el-polo",
      "database_id": "6c94e83f-d6b6-470a-9419-ada061b9154f",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
